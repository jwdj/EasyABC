#: tune_elements.py:560 tune_elements.py:706
msgid "Stylesheet directive"
msgstr "Instruction de format"

#: tune_elements.py:560 tune_elements.py:712
#, python-format
msgid ""
"A stylesheet directive is a line that starts with %%, followed by a "
"directive that gives instructions to typesetting or player programs."
msgstr ""
"Une instruction de format est une ligne commençant par %%, suivi par un "
"libellé permettant de définir des comportements particuliers pour les "
"logiciels générant les partitions ou les lecteurs MIDI."

#: tune_elements.py:578
msgid "MIDI directive"
msgstr "Instruction MIDI"

#: tune_elements.py:578
msgid "A directive that gives instructions to player programs."
msgstr ""
"Une directive permettant de définir des caractéristiques pour les lecteurs "
"MIDI."

#: tune_elements.py:584
msgid "Sets the instrument for a MIDI channel."
msgstr "Défini l’instrument utilisé pour le Channel MIDI."

#: tune_elements.py:591
msgid "Sets the instrument for playing chords."
msgstr "Défini l’instrument utilisé pour les accords de guitare."

#: tune_elements.py:598
msgid "Sets the instrument for the base."
msgstr "Défini l’instrument utilisé pour la basse."

#: tune_elements.py:606
msgid "Channel"
msgstr "Voix"

#: tune_elements.py:606
msgid "Sets the MIDI channel for the current voice."
